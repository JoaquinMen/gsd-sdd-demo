# ==============================================================================
# Cimbal SA Secure Operations Platform — Environment Configuration
# ==============================================================================

# Google Cloud Project & Location
GOOGLE_CLOUD_PROJECT=cimbal-ag-prod
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.5-flash

# Virtual Private Cloud (VPC) & Direct VPC Egress
VPC_NETWORK_NAME=cimbal-secure-vpc
VPC_SUBNET_NAME=cimbal-direct-egress-subnet
VPC_SUBNET_CIDR=10.0.1.0/24

# Identity-Aware Proxy (IAP) Settings
IAP_ENABLED=TRUE
IAP_BYPASS_DEV=TRUE
IAP_AUDIENCE=/projects/123456789012/locations/us-central1/services/cimbal-ops-portal

# BigQuery Analytical Warehouse
BQ_DATASET_ID=cimbal_operations
BQ_TABLE_ID=equipment_service_billing

# Object Storage & Vertex AI Search (Discovery Engine)
GCS_DOCS_BUCKET=cimbal-ag-prod-equipment-docs
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATASTORE_ID=cimbal-equipment-policies-ds

# System & Network
PORT=8080
SSL_CERT_FILE=/etc/ssl/cert.pem
